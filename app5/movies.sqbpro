<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="movies.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="1"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1517"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="0" parent="0"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title=" movies_1" custom_title="0" dock_id="1" table="4,9:main movies_1"/><dock_state state="000000ff00000000fd00000001000000020000042f00000215fc0100000001fb000000160064006f0063006b00420072006f007700730065003101000000000000042f0000012300ffffff000002690000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name=" movies_1" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="199"/><column index="3" value="127"/><column index="4" value="300"/><column index="5" value="167"/><column index="6" value="42"/><column index="7" value="95"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">INSERT INTO &quot; movies&quot; (title, image_path, description, director, rating, youtube_url) VALUES
('Inception', 'assets/8001.jpg', 'A thief who enters people''s dreams to steal secrets takes on the ultimate heist.', 'Christopher Nolan', 9.0, '8hP9D6kZseM'),
('The Shawshank Redemption', 'assets/8002.jpg', 'Two imprisoned men bond over a number of years, finding solace and eventual redemption through acts of common decency.', 'Frank Darabont', 9.3, '6hB3S9bIaco'),
('The Godfather', 'assets/8003.jpg', 'The aging patriarch of an organized crime dynasty transfers control of his clandestine empire to his reluctant son.', 'Francis Ford Coppola', 9.2, 'sY1S34973zA'),
('The Dark Knight', 'assets/8004.jpg', 'When the menace known as the Joker emerges from his mysterious past, he wreaks havoc and chaos on the people of Gotham.', 'Christopher Nolan', 9.0, 'EXeTwQWrcwY'),
('Forrest Gump', 'assets/8005.jpg', 'The presidencies of Kennedy and Johnson, the Vietnam War, the Watergate scandal and other historical events unfold from the perspective of an Alabama man with an IQ of 75.', 'Robert Zemeckis', 8.8, 'bLvqoHBptjg'),
('Schindler''s List', 'assets/8006.jpg', 'In German-occupied Poland during World War II, industrialist Oskar Schindler gradually becomes concerned for his Jewish workforce after witnessing their persecution by the Nazis.', 'Steven Spielberg', 9.0, 'gG22XNhtnoY'),
('The Matrix', 'assets/8007.jpg', 'A computer hacker learns from mysterious rebels about the true nature of his reality and his role in the war against its controllers.', 'The Wachowskis', 8.7, 'm8e-FF8MsqU'),
('Fight Club', 'assets/8008.jpg', 'An insomniac office worker and a devil-may-care soapmaker form an underground fight club that evolves into something much, much more.', 'David Fincher', 8.8, 'qtRKdVHc-cE'),
('Pulp Fiction', 'assets/8009.jpg', 'The lives of two mob hitmen, a boxer, a gangster and his wife, and a pair of diner bandits intertwine in four tales of violence and redemption.', 'Quentin Tarantino', 8.9, 's7EdQ4FqbhY'),
('Gladiator', 'assets/8010.jpg', 'A former Roman General sets out to exact vengeance against the corrupt emperor who murdered his family and sent him into slavery.', 'Ridley Scott', 8.5, 'ol67qo3WhJk');</sql><current_tab id="0"/></tab_sql></sqlb_project>
